<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ring_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/textRingTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="56sp"
        android:textStyle="bold"
        tools:text="07:30" />

    <TextView
        android:id="@+id/textRingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/white"
        android:textSize="20sp"
        tools:text="İş" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/textSwipeSnoozeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:text="@string/ring_swipe_snooze_hint"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textSwipeDismissHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/ring_swipe_dismiss_hint"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- PIN section -->
    <LinearLayout
        android:id="@+id/layoutPinSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_dismiss_hint"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/textPinDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.3"
            android:minHeight="32dp"
            android:textColor="@color/white"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/textRingError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ring_pin_wrong"
            android:textColor="@android:color/holo_orange_light"
            android:visibility="invisible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="24dp" />

        <GridLayout
            android:id="@+id/gridPinPad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4">

            <Button android:id="@+id/button1" style="@style/PinPadButton" android:text="1" />
            <Button android:id="@+id/button2" style="@style/PinPadButton" android:text="2" />
            <Button android:id="@+id/button3" style="@style/PinPadButton" android:text="3" />
            <Button android:id="@+id/button4" style="@style/PinPadButton" android:text="4" />
            <Button android:id="@+id/button5" style="@style/PinPadButton" android:text="5" />
            <Button android:id="@+id/button6" style="@style/PinPadButton" android:text="6" />
            <Button android:id="@+id/button7" style="@style/PinPadButton" android:text="7" />
            <Button android:id="@+id/button8" style="@style/PinPadButton" android:text="8" />
            <Button android:id="@+id/button9" style="@style/PinPadButton" android:text="9" />
            <View android:layout_width="72dp" android:layout_height="72dp" />
            <Button android:id="@+id/button0" style="@style/PinPadButton" android:text="0" />
            <ImageButton
                android:id="@+id/buttonBackspace"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_button"
                android:contentDescription="@string/action_delete"
                android:padding="20dp"
                android:src="@drawable/ic_backspace" />
        </GridLayout>
    </LinearLayout>

    <!-- Pattern section -->
    <LinearLayout
        android:id="@+id/layoutPatternSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_dismiss_hint_pattern"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textPatternError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ring_pattern_wrong"
            android:textColor="@android:color/holo_orange_light"
            android:visibility="invisible" />

        <com.metehanyl.calarsaat.ui.PatternLockView
            android:id="@+id/patternLockRing"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pattern_lock"
            android:padding="16dp" />
    </LinearLayout>

    <!-- Text password section -->
    <LinearLayout
        android:id="@+id/layoutTextSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ring_dismiss_hint_text"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/textTextError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ring_text_wrong"
            android:textColor="@android:color/holo_orange_light"
            android:visibility="invisible" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutRingTextPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRingTextPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_pass_hint"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#80FFFFFF" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/buttonConfirmText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/accent"
            android:text="@string/ring_confirm_button" />
    </LinearLayout>

</LinearLayout>
