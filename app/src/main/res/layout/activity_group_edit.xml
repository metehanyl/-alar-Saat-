<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            android:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGroupName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/group_name_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonAddTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/add_time_button"
                style="@style/Widget.Material3.Button.TextButton" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerTimes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_group_time" />

                <TextView
                    android:id="@+id/emptyTimesHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/group_no_times_hint"
                    android:textColor="?android:attr/textColorSecondary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/repeat_title"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGroupDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleLine="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/melody_title"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupGroupMelody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioGroupMelody0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/melody_classic"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioGroupMelody1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/melody_digital" />

                <RadioButton
                    android:id="@+id/radioGroupMelody2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/melody_triplet" />

                <RadioButton
                    android:id="@+id/radioGroupMelody3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/melody_rising" />

                <RadioButton
                    android:id="@+id/radioGroupMelody4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/melody_siren" />
            </RadioGroup>

            <Button
                android:id="@+id/buttonPreviewGroupMelody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/melody_preview"
                style="@style/Widget.Material3.Button.TextButton" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/volume_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textGroupVolumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="100%" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekGroupVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:min="1"
                android:max="100"
                android:progress="100" />

            <!-- Lock type selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/lock_type_title"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupGroupLockType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioGroupLockNone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lock_type_none"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/radioGroupLockPin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lock_type_pin" />

                <RadioButton
                    android:id="@+id/radioGroupLockPattern"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lock_type_pattern" />

                <RadioButton
                    android:id="@+id/radioGroupLockText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lock_type_text" />
            </RadioGroup>

            <!-- PIN lock section -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutGroupLockPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:passwordToggleEnabled="true"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGroupLockPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pin_entry_hint"
                    android:inputType="numberPassword"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pattern lock section -->
            <LinearLayout
                android:id="@+id/layoutGroupLockPattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/textGroupPatternStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/pattern_draw_hint"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <com.metehanyl.calarsaat.ui.PatternLockView
                    android:id="@+id/patternLockViewGroup"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_pattern_lock"
                    android:padding="12dp" />
            </LinearLayout>

            <!-- Text password lock section -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutGroupLockText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:passwordToggleEnabled="true"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editGroupLockText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/text_pass_hint"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/buttonSaveGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="@color/accent"
                android:text="@string/action_save" />

            <Button
                android:id="@+id/buttonDeleteGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/group_delete_button"
                android:textColor="@android:color/holo_red_light"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
